# Database
DATABASE_URL="postgresql://user:password@localhost:5432/linnan_encrypted"

# Server
PORT=3000
NODE_ENV="development"

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET="your-secret-key-here"

# Client URL (for CORS)
CLIENT_URL="http://localhost:3000"

# WebSocket
WS_PORT=3001

# Instagram OAuth ("Instagram API with Instagram Login", registered in the Meta developer
# dashboard). INSTAGRAM_REDIRECT_URI must exactly match this backend's public
# /api/auth/instagram/callback URL and be registered as-is in the Meta app settings.
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
INSTAGRAM_REDIRECT_URI="https://<your-backend-domain>/api/auth/instagram/callback"

# Must match the Android app's applicationId-based redirect scheme (see
# android/app/build.gradle.kts -> manifestPlaceholders["oauthRedirectScheme"]).
APP_REDIRECT_SCHEME="com.linnan.encrypted"
